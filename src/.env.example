# Copy this file to .env and fill in your actual values
# NEVER commit the .env file — it is in .gitignore

# IBM watsonx.ai & IBM Bob Integration
# NOTE: These variables are NOT required for the core AssetSentinel application to run.
# They are only required if you are configuring the IBM Bob IDE or connecting
# a live Watsonx client to the backend MCP tools.
WATSONX_API_KEY=your_api_key_here
WATSONX_PROJECT_ID=your_project_id_here
WATSONX_URL=https://eu-de.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-4-h-small

# Database (if used)
# Note: AssetSentinel uses a local SQLite database for the core hackathon demo.
DATABASE_URL=sqlite:///./asset_sentinel.db

# Application
APP_PORT=8000
APP_ENV=development

# Notifications (optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url

# Add your project-specific variables below
